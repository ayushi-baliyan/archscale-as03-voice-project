generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Task {
  id        Int      @id @default(autoincrement())
  title     String
  assignee  String   @default("Unassigned")
  status    String   @default("To Do")
  project   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}